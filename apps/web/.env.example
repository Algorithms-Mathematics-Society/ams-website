# Paste the values from Firebase Console > Project settings > Your apps.
# Web app configuration is public by design. Never paste a service-account key here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional override: deployed function URL (or local emulator URL in development).
# Without this override, the URL is derived from the project ID and asia-south1.
UPDATES_SIGNUP_ENDPOINT=

# Domain-restricted Firebase App Check reCAPTCHA Enterprise site key.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
